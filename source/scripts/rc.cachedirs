#!/bin/bash
#
plugin="dynamix.cache.dirs"
script="cache_dirs"
execute="/usr/local/emhttp/plugins/$plugin/scripts/$script"
options="/etc/$script.conf"
run="/tmp/$script.run"

log() {
	logger -t "$script" "$*"
}

start_cache_dirs() {
	local rc=0
	
	if [[ -z $(pgrep -f "$execute") ]]; then
		#
		# Ensure folder names are properly quoted
		#
		echo "$execute $(cat "$options") 2>/dev/null" > "$run"
		source "$run"
		rc=$?

		rm -f "$run"

		if ((rc != 0)); then
			log "$script failed to start (exit code $rc)"
		fi
	else
		log "$script already running!"
	fi

	return "$rc"
}

stop_cache_dirs() {
	local rc=0
	local timer=5

	#
	# Always request shutdown so cache_dirs can clean up its
	# subprocesses and lock file, even if no main process is found.
	#
	"$execute" -q &>/dev/null

	while pgrep -f "$execute" >/dev/null && ((timer > 0)); do
		sleep 1
		timer=$((timer - 1))
	done

	if pgrep -f "$execute" >/dev/null; then
		log "$script process still running"
		rc=1
	fi

	return "$rc"
}

restart_cache_dirs() {
	local rc=0

	stop_cache_dirs
	rc=$?

	if [ "$rc" -eq 0 ]; then
		sleep 2
		start_cache_dirs
		rc=$?
	fi

	return "$rc"
}

case "$1" in
	start)
		start_cache_dirs ;;

	stop)
		stop_cache_dirs ;;

	restart)
		restart_cache_dirs ;;

	*)
		log "Usage: $(basename "$0") start|stop|restart"
		;;
esac
