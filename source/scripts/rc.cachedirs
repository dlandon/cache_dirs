#!/bin/bash
#
plugin="dynamix.cache.dirs"
script="cache_dirs"
execute="/usr/local/emhttp/plugins/$plugin/scripts/$script"
options="/etc/$script.conf"
run="/tmp/$script.run"

log() {
	logger -t "$script" "$*"
}

start_cache_dirs() {
	if [[ -z $(pgrep -f "$execute") ]]; then
		#
		# Ensure folder names are properly quoted
		#
		echo "$execute $(cat "$options") 2>/dev/null" > "$run"
		source "$run"
		rc=$?

		rm -f "$run"

		if ((rc != 0)); then
			log "$script failed to start (exit code $rc)"
		fi
	else
		log "$script already running!"
	fi
}

stop_cache_dirs() {
	if [[ -n $(pgrep -f "$execute") ]]; then
		"$execute" -q &>/dev/null
		timer=5
		until [[ -z $(pgrep -f "$execute") || $timer -eq 0 ]]; do
			timer=$((timer-1))
			sleep 1
		done
		if [[ -n $(pgrep -f "$execute") ]]; then
			log "$script process still running"
		fi
	else
		#
		# Always execute because cache_dirs uses subprocesses and lock-file, and it may need to clean up
		#
		"$execute" -q &>/dev/null
	fi
}

restart_cache_dirs() {
	stop_cache_dirs
	sleep 2
	start_cache_dirs
}

case "$1" in
	start)
		start_cache_dirs ;;

	stop)
		stop_cache_dirs ;;

	restart)
		restart_cache_dirs ;;

	*)
		log "Usage: $(basename "$0") start|stop|restart"
		;;
esac
