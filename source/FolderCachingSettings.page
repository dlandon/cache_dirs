<?
/* Define our plugin name. */
define('CACHE_DIRS_PLUGIN', 'dynamix.cache.dirs');

/* Define the docroot path. */
if (!defined('DOCROOT')) {
	define('DOCROOT', $_SERVER['DOCUMENT_ROOT'] ?: '/usr/local/emhttp');
}

define('CACHE_DIRS_CFG_FILE', CACHE_DIRS_PLUGIN."/".CACHE_DIRS_PLUGIN.".cfg");
define('CACHE_DIRS_PHP_FILE', "plugins/".CACHE_DIRS_PLUGIN."/include/update.cache.php");
define('CACHE_DIRS_CONFIG_FILE', "/etc/cache_dirs.conf");
define('CACHE_DIRS_SCRIPT', DOCROOT."/plugins/".CACHE_DIRS_PLUGIN."/scripts/cache_dirs");

$cfg    = parse_plugin_cfg(CACHE_DIRS_PLUGIN, false, INI_SCANNER_RAW);

/* Strip slashes from the other field. */
$cfg['other'] = stripcslashes($cfg['other']);

$pools  = $pools ?? ['cache'];
$search = ['/mnt/disk[0-9]*'];

/* Get all the pool devices. */
foreach ($pools as $pool) {
    if (isset($disks[$pool])) {
        $search[] = "/mnt/$pool";
    }
}
$search = implode(' ', $search);

exec("find $search -type d -maxdepth 1 -mindepth 1 -exec basename \"{}\" \;|sort -u|uniq", $folders);

/* Folders that shouldn't be cached. */
$no_cache = [
	"appdata",
	"domains",
	"system",
	".Recycle.Bin"
];

/* Remove folders that shouldn't be cached. */
$folders = array_diff($folders, $no_cache);

/* Default all eligible disk shares cached. */
if ($cfg['include'] == "") {
	$cfg['include'] = implode(",", $folders);
}

/* Build help text for excluded folders. */
$help_cache			= array_diff($no_cache, [".Recycle.Bin"]);
$excluded_folders	= implode(", ", array_map(fn($f) => "`$f`", $help_cache));

/* Is the cache_dirs script running. */
$running		= false;
$lockfile		= "/var/lock/cache_dirs.LCK";

if (is_file($lockfile)) {
	$pid		= (int)trim(file_get_contents($lockfile));
	$running	= !empty(trim(shell_exec("pidof -s -x cache_dirs")));
}
?>

<link rel="stylesheet" href="<?autov("/plugins/".CACHE_DIRS_PLUGIN."/assets/cache_dirs.css")?>">

<div class="cache-header">
	<div class="cache-version">
		<?=trim(exec(CACHE_DIRS_SCRIPT." -V"))?>
	</div>
</div>

<div class="cache-content">
<div class="cache-settings">
<form markdown="1" name="cache_settings" method="POST" action="/update.php" target="progressFrame" onsubmit="prepareCache(this)">
<input type="hidden" name="#file" value="<?=CACHE_DIRS_CFG_FILE;?>">
<input type="hidden" name="#include" value="<?=CACHE_DIRS_PHP_FILE;?>">
<input type="hidden" name="#config" value="<?=CACHE_DIRS_CONFIG_FILE;?>">
<input type="hidden" name="#prefix" value="minimum=m&maximum=M&include=i&log=l&diskIdleTimer=W&scanTimeoutIdle=X&scanTimeoutBusy=Y&scanTimeoutStable=Z&ulimit=U&cachePressure=p&minDepth=c">

:cachedirs_info_plug:
> Folder Caching
>
> Folder Caching keeps directory information in memory to reduce the need for disks to spin up when browsing shares.
>
> Because Linux manages memory dynamically, cached directory information may be discarded when the system is under memory pressure. When this happens, cache_dirs must reread the directories from disk, which may temporarily spin up one or more drives.
>
> Adaptive mode automatically adjusts the scan depth to reduce disk activity while maintaining as much of the directory cache as possible.
>
> Limiting the folders being cached and using an appropriate scan depth reduces memory usage and helps minimize unnecessary disk spin-ups.
:end

_(Folder Caching)_:
: <span class="inline-block">
  <select name="service" class="cache-dirs-input">
  <?=mk_option($cfg['service'], "0", _("Disabled"))?>
  <?=mk_option($cfg['service'], "1", _("Enabled"))?>
  </select>
</span>

:cachedirs_function_plug:
> Enables or disables Folder Caching.
>
> Folder Caching runs only while the array is started. It is automatically started when the array starts and stopped when the array stops.
:end

_(Folders to cache)_:
: <span class="inline-block cache-dirs-include">
  <select id="s1" name="include" style="display:none" multiple>
  <?foreach ($folders as $folder):?>
    <?=mk_option_check($cfg['include'], htmlspecialchars($folder), htmlspecialchars($folder))?>
  <?endforeach;?>
  </select>
</span>

:cachedirs_included_folders_plug:
> The dropdown menu shows the folders available for caching. By default, all eligible folders are selected.
>
> The folders <?=$excluded_folders?> are not shown because they are not intended to be cached.
>
> Select the folders you want to cache.
:end

_(Directory Cache Pressure)_:
: <span class="inline-block">
  <input type="number" name="cachePressure" class="narrow" maxlength="4" value="<?=htmlspecialchars($cfg['cachePressure'])?>" placeholder="10" min="10">
</span>

:cachedirs_pressure_plug:
> Controls how aggressively Linux reclaims cached directory information from memory.
>
> The default value of **10** is recommended for most systems.
>
> If your disks spin up frequently or the cache_dirs log reports repeated cache misses, try lowering this value to **1**.
>
> If your system runs low on memory, increase the value to allow Linux to reclaim cached directories more aggressively.
>
> **Warning:** Setting the value to **0** prevents Linux from reclaiming cached directory information. On systems with insufficient memory this can lead to memory exhaustion and system instability.
>
> This setting is not restored when cache_dirs stops. To restore the Linux default, run:
>
> `sysctl vm.vfs_cache_pressure=100`
>
> See the Linux kernel documentation for additional information.
:end

_(Suspend During Mover)_:
: <span class="inline-block">
  <select name="suspend" class="narrow">
  <?=mk_option($cfg['suspend'], "-S", _("No"))?>
  <?=mk_option($cfg['suspend'], "", _("Yes"))?>
  </select>
</span>

:cachedirs_suspend_plug:
> Stops Folder Caching while the Mover is running.
>
> **No** is recommended when using Adaptive mode, since Folder Caching automatically reduces its activity if needed.
>
> **Yes** is recommended when using Fixed mode to minimize disk activity while the Mover is relocating files.
:end

_(Scan User Shares (/mnt/user))_:
: <span class="inline-block">
  <select name="shares" class="narrow">
  <?=mk_option($cfg['shares'], "", _("No"))?>
  <?=mk_option($cfg['shares'], "-u", _("Yes"))?>
  </select>
</span>

:cache_dirs_shares_plug:
> Also scans the User Shares file system (`/mnt/user`) in addition to the individual disk and pool mount points.
>
> Enabling this option can help reduce disk spin-ups when browsing User Shares, but it may increase CPU usage because the User Shares file system must also be scanned.
>
> Leave this option disabled unless you experience unnecessary disk spin-ups when accessing User Shares.
:end

_(Scan Mode)_:
: <span class="inline-block">
  <select id="adaptive" name="adaptive" class="cache-dirs-input">
    <?=mk_option($cfg['adaptive'], "1", _("Adaptive"))?>
    <?=mk_option($cfg['adaptive'], "0", _("Fixed"))?>
  </select>
</span>

:cachedirs_adaptive_depth_plug:
> Selects how Folder Caching determines the directory scan depth.
>
> **Adaptive** automatically adjusts the scan depth based on system activity to reduce unnecessary disk access. The scan depth will not exceed the configured Maximum Depth.
>
> **Fixed** always scans to the configured Maximum Depth.
>
> Adaptive mode is recommended for most systems.
:end

_(Minimum Scan Depth)_:
: <span class="inline-block">
  <input id="minDepth" type="number" name="minDepth" class="narrow" maxlength="2" value="<?=htmlspecialchars($cfg['minDepth'])?>" placeholder="4" min="0" max="99" >
</span>

:cachedirs_min_level_plug:
> Sets the minimum scan depth used by Adaptive mode.
>
> For example, **Share / Folder / Subfolder** is a depth of **2**.
>
> The default is **4**.
:end

_(Maximum Scan Depth)_:
: <span class="inline-block">
  <input type="number" name="depth" class="narrow" maxlength="4" value="<?=htmlspecialchars($cfg['depth'])?>" placeholder="0 - _(Unlimited)_"  min="0" max="9999">
</span>

:cachedirs_max_level_plug:
> Sets the maximum directory depth to scan.
>
> For example, **Share / Folder / Subfolder** is a depth of **2**.
>
> In **Adaptive** mode, the scan depth will never exceed this value.
>
> In **Fixed** mode, this is the depth that is always scanned.
>
> Set the value to **0** for no maximum limit.
:end

_(Disk Idle Time)_:
: <span class="inline-block">
  <input type="number" name="diskIdleTimer" class="narrow" maxlength="4" value="<?=htmlspecialchars($cfg['diskIdleTimer'])?>" placeholder="60" min="60">
</span>

:cachedirs_idle_timer_plug:
> Sets how long the disks must remain idle before Folder Caching begins scanning directories.
>
> Increasing this value delays scanning until the system has been idle longer. The default is **60** seconds.
:end

_(Idle Scan Timeout)_:
: <span class="inline-block">
 <input type="number" name="scanTimeoutIdle" class="narrow" maxlength="4" value="<?=htmlspecialchars($cfg['scanTimeoutIdle'])?>" placeholder="150" min="150">
</span>

:cachedirs_timeout_scan_plug:
> Sets the maximum time allowed for a directory scan while the disks are idle.
>
> If a scan takes longer than this limit, Adaptive mode reduces the scan depth to minimize disk activity.
>
> Increase this value if Folder Caching is unable to cache all of your directories.
>
> This timeout is always used when Fixed mode is selected.
:end

_(Startup/Busy Scan Timeout)_:
: <span class="inline-block">
  <input type="number" name="scanTimeoutBusy" class="narrow" maxlength="4" value="<?=htmlspecialchars($cfg['scanTimeoutBusy'])?>" placeholder="30" min="30">
</span>

:cachedirs_timeout_initial_plug:
> Sets the maximum time allowed for directory scans during startup or while the system is busy.
>
> Unlike the Idle Scan Timeout, this setting applies before the disks have been idle long enough for normal background scanning.
>
> The default is **30** seconds.
:end

_(Stable Scan Timeout)_:
: <span class="inline-block">
  <input type="number" name="scanTimeoutStable" class="narrow" maxlength="4" value="<?=htmlspecialchars($cfg['scanTimeoutStable'])?>" placeholder="20" min="20">
</span>

:cachedirs_timeout_cached_plug:
> Sets the maximum time allowed for directory scans after all directories have been successfully cached.
>
> Decrease this value to reduce CPU and disk activity when the system is busy.
>
> Increase this value to improve the chances of keeping directory information cached in memory.
>
> The default is **20** seconds.
:end

_(Minimum Scan Interval)_:
: <span class="inline-block">
  <input type="number" name="minimum" class="narrow" maxlength="3" value="<?=htmlspecialchars($cfg['minimum'])?>" placeholder="1" min="1">
</span>

:cachedirs_min_interval_plug:
> Sets the minimum time between directory scans.
>
> Increasing the interval reduces system activity but may delay updates to the directory cache.
>
> The default is **1** second.
:end

_(Maximum interval between folder scans)_:
: <span class="inline-block">
  <input type="number" name="maximum" class="narrow" maxlength="3" value="<?=htmlspecialchars($cfg['maximum'])?>" placeholder="10" min="10">
</span>

:cachedirs_max_interval_plug:
> Tweaking of the caching interval can be done for slower systems. Default value is 10 seconds, should be alright for most systems.
:end

_(Scan Disks Concurrently)_:
: <select name="multithreaded" class="narrow">
  <?=mk_option($cfg['multithreaded'], "", _("Yes"))?>
  <?=mk_option($cfg['multithreaded'], "-T", _("No"))?>
  </select>

:cachedirs_scan_disk_plug:
> Scans each disk concurrently to reduce the time required to build or maintain the directory cache.
>
> When enabled, directory scans complete faster but may increase CPU and disk activity.
>
> If User Shares are also scanned, the User Shares scan runs after the individual disk scans have completed.
:end

_(Memory Limit)_:
: <span class="inline-block">
  <input type="number" name="ulimit" class="narrow" maxlength="6" value="<?=htmlspecialchars($cfg['ulimit'])?>" placeholder="50000" min="0">
</span>

:cachedirs_limit_memory_plug:
> Limits the amount of memory that the Folder Caching process can use.
>
> The default value is **50000**. Set the value to **0** to remove the memory limit and use the system default.
>
> Most users should leave this setting at its default value.
:end

_(Logging)_:
: <span class="inline-block">
  <select name="log" class="cache-dirs-input">
  <?=mk_option($cfg['log'], "off", _("Disabled"))?>
  <?=mk_option($cfg['log'], "on", _("Enabled"))?>
  </select>
</span>

:cachedirs_logging_plug:
> Enables or disables diagnostic logging for Folder Caching.
>
> Log files are written to:
>
> - `/var/log/cache_dirs.log`
> - `/var/log/cache_dirs_lost_cache.csv`
>
> On Unraid, these log files are stored in memory and are cleared on reboot. They are not automatically rotated, so logging should normally remain disabled and only be enabled when troubleshooting.
:end

_(Advanced Options)_:
: <span class="inline-block">
  <input id="pin" type="text" name="other" class="wide" maxlength="200" value="<?=htmlspecialchars($cfg['other'])?>" placeholder="_(Additional cache_dirs options)_">
  _(See)_ <u><a href="https://forums.unraid.net/topic/4351-cache_dirs-an-attempt-to-keep-directory-entries-in-ram-to-prevent-disk-spin-up/" target="_blank">_(Unraid forum)_</a></u>
</span>

:cachedirs_user_defined_plug:
> Specifies additional command-line options to pass directly to the `cache_dirs` script.
>
> Most users should leave this field empty.
>
> Refer to the Unraid forum discussion or the `cache_dirs` script for additional options and usage examples. Advanced users may also specify the `-e` option here to exclude directories from being scanned.
>
> **Example:** Exclude `.Recycle.Bin`, `log`, and `temp` directories from being scanned:
>
> <span class="strong orange-text">-a '-noleaf -name .Recycle.Bin -prune -o -name log -prune -o -name temp -prune -o -print'</span>
>
> **Note:** The argument to `-a` must be enclosed in **single quotes**. Double quotes are not supported.
:end

<input type="submit" name="#default" value="_(Default)_">
: <span class="inline-block">
  <input type="submit" name="#apply" value="_(Apply)_"><input type="button" value="_(Done)_" onclick="done()">
</span>
</form>
</div>

<div class="cache-summary">
	<div class="cache-summary-title"><?=_("Folder Caching Summary")?></div>

	<div><strong><?=_("Function")?>:</strong> <?=$cfg['service'] ? _("Enabled") : _("Disabled")?></div>

	<div><strong><?=_("Mode")?>:</strong> <?=$cfg['adaptive'] ? _("Adaptive") : _("Fixed")?></div>

	<?if ($cfg['adaptive']): ?>
	<div><strong><?=_("Minimum Depth")?>:</strong> <?=htmlspecialchars($cfg['minDepth'] ?: 4)?></div>
	<?endif; ?>

	<div><strong><?=_("Maximum Depth")?>:</strong> <?=($cfg['depth'] ?: _("Unlimited"))?></div>

	<div><strong><?=_("Scan User Shares")?>:</strong> <?=$cfg['shares'] ? _("Yes") : _("No")?></div>

	<div><strong><?=_("Suspend During Mover")?>:</strong> <?=$cfg['suspend'] ? _("No") : _("Yes")?></div>

	<div><strong><?=_("Logging")?>:</strong> <?=($cfg['log'] == "on") ? _("Enabled") : _("Disabled")?></div>

	<div class="cache-summary-heading"><?=_("Cached Folders")?></div>
	<?if ($running): ?>
		<?
		$included = array_filter(array_map('trim', explode(',', $cfg['include'])));
		sort($included, SORT_NATURAL | SORT_FLAG_CASE);
		foreach ($included as $folder) {
			echo "<div>".htmlspecialchars($folder)."</div>";
		}
		?>
	<?else:?>
		<div><?=_("No folders are currently being cached")?>.</div>
	<?endif; ?>
</div>
</div>

<script>
function prepareCache(form) {
/* Simulate a single input field. */
	let include = [];
	for (let i=0,item; item=form.include.options[i]; i++) {
		if (item.selected) {
			include.push(item.value);
			item.selected = false;
		}
	}
	item = form.include.options[0];
	item.value = include.join(',');
	item.selected = true;
}

function updateAdaptiveSettings() {
	const adaptive = $('#adaptive').val() === '1';

	$('#minDepth')
		.prop('disabled', !adaptive)
		.toggleClass('disabled', !adaptive);
}

$(function() {
	let size = Math.max(window.innerHeight-$('#pin').offset().top-150,150);
	let width = Math.max($('#s1').parent().width(), 400);

	$('#s1').dropdownchecklist({
		maxDropHeight: size,
		width: width,
		explicitClose: '..._(close)_'
	});

	$('#adaptive').on('change', updateAdaptiveSettings);
	updateAdaptiveSettings();

	showStatus('cache_dirs');
});
</script>
